From: Andrew Branson <andrew.branson@jolla.com>
Subject: [PATCH] Require TLS 1.2 by default in the shared configuration

Apply the TLS minimum through system_default so both OpenSSL 3 and the
OpenSSL 1.1 compatibility library use it when loading the system config.
Applications can still explicitly override the configured minimum.

--- a/apps/openssl.cnf
+++ b/apps/openssl.cnf
@@ -51,7 +51,14 @@
 # .include fipsmodule.cnf

 [openssl_init]
+ssl_conf = ssl_sect
 providers = provider_sect
+
+[ssl_sect]
+system_default = system_default_sect
+
+[system_default_sect]
+MinProtocol = TLSv1.2

 # List of providers to load
 [provider_sect]
